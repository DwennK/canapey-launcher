{
  "name": "canapey-launcher",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check": "npm run version:check && npm run build && npm test && npm run test:rust",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs",
    "release:configure": "node scripts/configure-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.1"
  }
}
